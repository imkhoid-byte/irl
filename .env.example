# ONCE runs in local DEMO MODE with no secrets configured.
# Everything below is optional.

# Where the demo SQLite database lives (default: ./data/once.db)
# ONCE_DB_PATH=./data/once.db

# Secret used to sign mock payment webhooks. Any random string in dev.
MOCK_WEBHOOK_SECRET=dev-only-change-me

# Payment provider: "mock" (default) or "stripe" (test mode, see README).
PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase (Phase 2 — not required for demo mode)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/cron/sweep in production.
# CRON_SECRET=
